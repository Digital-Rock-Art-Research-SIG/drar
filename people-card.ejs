```{=html}

<div class="quarto-listing quarto-listing-container-grid">
  
  <div class="list grid quarto-listing-cols-3"> 

    <% for (const item of items) { ;%> 
    
    <div class="g-col-1 listing-box">
      
      
      
      <a href="<%- item.path %>" role="button" class="quarto-grid-link">
        <div class="quarto-grid-item card h-100 card-left">
          
          
          <p class="card-img-top">
            <img alt="<%= item.name %>" src="<%= item.img %>" class="thumbnail-image card-img listing-box-image" style="height: 150px;">
          </p>
          
          <div class="card-body post-contents">
            
            <div class="listing-box-name">
              <%= item.name %><br> 
            </div>
               
            <div class="listing-box-affil">
              <%= item.affiliation %><br>
            </div>
                
            
              
              <div class="listing-box-keywords">
                
                <% if (item.keywords) { %>
                  <%= item.keywords.join(', ') %><br>
                  <%} else { %>
                    <p>  </p>
                    <% } %>
                    
              </div>  
                  

            
            
          </div>  
        </div>  
      </a>
      
    </div>
  
    <% } %>
  
</div>
</div>

```