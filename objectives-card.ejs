```{=html}

<div class="quarto-listing quarto-listing-container-grid">
  
  <div class="list grid quarto-listing-cols-2"> 

    <% for (const item of items) { ;%> 
    
    <div class="g-col-1 listing-box">
        <div class="quarto-grid-item card h-100 card-center">
            
            <div class="listing-box-icon">
              <%= item.icon %><br> 
            </div>
               
            <div class="listing-box-title">
              <%= item.title %><br>
            </div>
                
              <div class="listing-box-desc">
                <% if (item.description) { %>
                  <p><%= item.description %></p>
                <% } %>
              </div>             
          </div>  
      
    </div>
  
    <% } %>
  
</div>
</div>

```